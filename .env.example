# ---------------------------------------------------------------------------
# The Cost of One Spin — environment variables
# Copy this file to `.env.local` and fill in your Supabase project values.
# ---------------------------------------------------------------------------

# Public Supabase URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser — protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The canonical site URL, used for auth redirects.
# Local dev: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
