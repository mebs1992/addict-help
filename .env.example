# ---------------------------------------------------------------------------
# The Cost of One Spin — environment variables (personal single-user mode)
# Copy this file to `.env.local` and fill in your Supabase project values.
# ---------------------------------------------------------------------------

# Public Supabase URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# SECRET service-role key (Project Settings -> API -> service_role).
# Server-only — never prefixed with NEXT_PUBLIC, never sent to the browser.
# This is what lets the app read/write your data without any login.
SUPABASE_SERVICE_ROLE_KEY=
